# Web Firebase configuration. Copy this file to `tool/.env.web` and fill in
# the values from your Firebase project (Project settings -> Your apps -> Web),
# then run `pwsh tool/run_web.ps1` or `pwsh tool/build_web.ps1`.
#
# NEVER commit `tool/.env.web`; it is gitignored. The examples below are
# placeholders only.
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_PROJECT_ID=
FIREBASE_WEB_STORAGE_BUCKET=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=